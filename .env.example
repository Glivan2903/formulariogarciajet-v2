# ---------------------------------------------------------------------------
# Envio da cotação por e-mail (canal principal)
# ---------------------------------------------------------------------------
# Dados do servidor SMTP da Exclusiva. Sem estas três variáveis o envio por
# e-mail falha e a cotação segue pelo webhook do n8n (fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Deixe vazio para decidir pela porta (465 = true, 587 = false)
SMTP_SECURE=

# Remetente das mensagens (mesmo usado hoje no n8n)
EMAIL_FROM=incendio@exclusivaseg.com.br

# Destinatário fixo que recebe todas as cotações.
# Os outros dois destinatários são os e-mails da matriz e do comercial,
# preenchidos pelo corretor na Etapa 1 do formulário.
EMAIL_DESTINATARIO_FIXO=patrimonial.asasessor@exclusivaseg.com.br

# Logo exibido no topo do e-mail (opcional). Precisa ser uma URL pública.
EMAIL_LOGO_URL=

# ---------------------------------------------------------------------------
# Fallback
# ---------------------------------------------------------------------------
# Acionado apenas quando nenhum dos e-mails consegue ser entregue.
N8N_WEBHOOK_URL=https://n8n.jetsalesbrasil.com/webhook/a45a7c61-c49e-4820-9daf-9ac590ec4d5a

# ---------------------------------------------------------------------------
# Anexos
# ---------------------------------------------------------------------------
# Limite total dos arquivos da Etapa 8, em MB.
# Atenção: na Vercel o corpo da requisição é limitado a ~4,5 MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=4
